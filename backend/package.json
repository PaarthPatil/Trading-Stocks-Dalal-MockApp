{
  "name": "stock-simulation-backend",
  "version": "1.0.0",
  "description": "Backend API for Stock Simulation Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup": "node setup.js",
    "check": "node check-startup.js",
    "db:init": "mysql -u root -p < database/schema.sql",
    "db:test": "node test-database.js",
    "db:seed": "node seed-database.js",
    "db:setup": "npm run db:init && npm run db:seed"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mysql2": "^3.6.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "socket.io": "^4.6.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
